{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Carpet 附属模组，为 Minecraft 1.21.6 ~ 1.21.10 追加 46 条游戏规则（仅服务端安装，规则默认关闭）。注意：本版本内容自 26.x 分支移植，可能存在 bug。",
  "authors": [
    "m62m61m80bpzm2"
  ],
  "contact": {
    "homepage": "https://github.com/m62m61m80bpzm2/carpet-vpl-addition",
    "sources": "https://github.com/m62m61m80bpzm2/carpet-vpl-addition",
    "issues": "https://github.com/m62m61m80bpzm2/carpet-vpl-addition/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "carpetvpladdition.CarpetVPLAdditionMod"
    ]
  },
  "mixins": [
    "carpet-vpl-addition.mixins.json"
  ],
  "modmenu": {
    "badges": [
      "beta"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=1.21.6 <1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "carpet": ">=1.4.176"
  }
}
